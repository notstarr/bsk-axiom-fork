{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialsResult",
  "type": "object",
  "required": [
    "cookie_count",
    "cookies",
    "formatted_headers",
    "storage_by_origin",
    "target"
  ],
  "properties": {
    "cookie_count": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "cookies": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CredentialEntry"
      }
    },
    "formatted_headers": {
      "description": "Pre-formatted replay headers; always contains a joined `\"Cookie\"` header.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "storage_by_origin": {
      "description": "Web storage from tabs already open on the target domain: origin -> { key -> value }. `sessionStorage` keys carry a `session:` prefix so they cannot collide with `localStorage`.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "target": {
      "description": "The domain extraction was scoped to.",
      "type": "string"
    }
  },
  "definitions": {
    "CredentialEntry": {
      "description": "One cookie as stored by the browser, including `HttpOnly` values that page scripts can never see.",
      "type": "object",
      "required": [
        "domain",
        "http_only",
        "name",
        "path",
        "secure",
        "value"
      ],
      "properties": {
        "domain": {
          "type": "string"
        },
        "expires": {
          "description": "Seconds since the UNIX epoch; `None` for session cookies.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "http_only": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "same_site": {
          "description": "`SameSite` attribute; `None` when the browser reports `unspecified`.",
          "type": [
            "string",
            "null"
          ]
        },
        "secure": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
