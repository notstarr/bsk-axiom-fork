{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CredentialEntry",
  "description": "One cookie as stored by the browser, including `HttpOnly` values that page scripts can never see.",
  "type": "object",
  "required": [
    "domain",
    "http_only",
    "name",
    "path",
    "secure",
    "value"
  ],
  "properties": {
    "domain": {
      "type": "string"
    },
    "expires": {
      "description": "Seconds since the UNIX epoch; `None` for session cookies.",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    },
    "http_only": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "same_site": {
      "description": "`SameSite` attribute; `None` when the browser reports `unspecified`.",
      "type": [
        "string",
        "null"
      ]
    },
    "secure": {
      "type": "boolean"
    },
    "value": {
      "type": "string"
    }
  }
}
